{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "start-sql",
      "type": "shell",
      "command": "docker compose up -d sql --wait",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "build-web",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/Web/RecipeLibrary.Web/RecipeLibrary.Web.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "predebug-local",
      "dependsOn": [
        "start-sql",
        "build-web"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "test-all",
      "type": "shell",
      "command": "dotnet test RecipeLibrary.slnx",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "test-e2e",
      "type": "shell",
      "command": "dotnet test tests/RecipeLibrary.Web.E2E.Tests",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "group": "test"
    }
  ]
}
