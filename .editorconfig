# EditorConfig for RecipeLibrary
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cs,csx}]
indent_size = 4

[*.{json,yml,yaml,js,css,html,razor}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{ps1,psm1,psd1}]
indent_size = 2

[*.resx]
indent_size = 2

[*.{sln,slnx}]
indent_style = tab
