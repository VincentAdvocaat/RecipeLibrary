@page "/starting"
@attribute [AllowAnonymous]
@attribute [Microsoft.AspNetCore.Components.ExcludeFromInteractiveRouting]
@layout RecipeLibrary.Components.Layout.AuthLayout
@using System.Globalization

<PageTitle>@L["Starting.PageTitle"]</PageTitle>
<div class="max-w-lg mx-auto bg-white border border-gray-200 rounded-lg p-8 text-center shadow-sm"
     data-startup data-backend="" data-language="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName"
     data-initial-failed="false" data-testid="starting-page" aria-busy="true">
    <h1 class="text-2xl font-semibold mb-3" data-heading>@L["Starting.Heading"]</h1>
    <p class="text-gray-600 mb-6" data-message>@L["Starting.Message"]</p>
    <p class="text-sm text-gray-500 mb-6" role="status" aria-live="polite" data-status>@L["Starting.Status"]</p>
    <button type="button" class="px-4 py-2 rounded border border-gray-300" data-retry hidden>@L["Starting.RetryButton"]</button>
    <p class="mt-6"><a href="@ReturnUrl" data-continue>@L["Auth.Login.Submit"]</a></p>
</div>
<script type="module" src="startup.js"></script>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? RequestedReturnUrl { get; set; }
    private string ReturnUrl => StartupReturnUrl.Normalize(RequestedReturnUrl);
}
