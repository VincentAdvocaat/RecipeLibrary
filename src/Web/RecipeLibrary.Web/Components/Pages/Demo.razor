@page "/demo"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using Microsoft.AspNetCore.Components.Endpoints
@using Microsoft.Extensions.Options
@using RecipeLibrary.Web.Demo
@layout RecipeLibrary.Components.Layout.AuthLayout
@inject DemoIdentity Identity
@inject IOptions<DemoOptions> Options
@inject DemoOperationRunner Guard
@inject NavigationManager Navigation

<PageTitle>@L["Demo.Title"]</PageTitle>
<main class="mx-auto max-w-lg rounded-lg border border-gray-200 bg-white p-6 space-y-4" data-testid="@UiTestIds.DemoStartPage">
    <h1 class="text-2xl font-semibold">@L["Demo.Title"]</h1>
    @if (Identity.IsAuthenticated && !Identity.IsDemo)
    {
        <p>@L["Demo.NormalAccount"]</p>
        <a href="/recipes" class="underline">@L["Demo.Back"]</a>
    }
    else if (!Options.Value.Enabled)
    {
        <p>@L["Demo.Disabled"]</p>
    }
    else
    {
        @if (!string.IsNullOrEmpty(Message))
        {
            <p role="status" data-testid="@UiTestIds.DemoState">@L[Message]</p>
        }
        else
        {
            <p role="status">@L["Demo.Preparing"]</p>
        }
        <form id="demo-start" method="post" action="/demo/start" data-enhance="false" data-auto-start="@AutoStart.ToString().ToLowerInvariant()">
            <AntiforgeryToken />
            <button type="submit" class="rounded bg-gray-900 px-4 py-2 text-white" data-testid="@UiTestIds.DemoStart">@L["Demo.Start"]</button>
        </form>
        <p class="text-sm text-gray-600">@L["Demo.Duration", Options.Value.LifetimeMinutes]</p>
    }
    <a href="/Account/Register" class="block text-sm underline">@L["Demo.Register"]</a>
</main>


@code {
    [SupplyParameterFromQuery(Name = "state")] public string? State { get; set; }
    private string? Message;
    private bool AutoStart;

    protected override async Task OnInitializedAsync()
    {
        Message = State switch
        {
            "expired" => "Demo.Expired", "reload" => "Demo.Reload", "limit" => "Demo.Limit",
            "disabled" => "Demo.Disabled", "ended" => "Demo.Ended", "accountrequired" => "Demo.AccountRequired", _ => null
        };
        if (!Options.Value.Enabled || (Identity.IsAuthenticated && !Identity.IsDemo)) return;
        if (Identity.IsDemo && Message is null)
        {
            try
            {
                await Guard.GetValidSessionAsync();
                Navigation.NavigateTo("/recipes", forceLoad: true);
                return;
            }
            catch (DemoAccessException ex) { Message = ex.Code; }
        }
        AutoStart = Message is null;
    }
}
